{
  "name": "vokabeltrainer",
  "productName": "Vokabeltrainer",
  "version": "2.1.0",
  "description": "Free, offline Quizlet-style vocabulary trainer for Windows: flashcards, learn, test, match, Excel import and an MCP server",
  "main": "./out/main/index.js",
  "author": "ApnX",
  "license": "MIT",
  "repository": "https://github.com/ApnXer/Vokable-Trainer",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:mcp",
    "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist-mcp/mcp-server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run build:mcp && vitest run",
    "start": "electron-vite preview",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "de.vokabeltrainer.app",
    "productName": "Vokabeltrainer",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["out/**/*", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "dist-mcp/mcp-server.cjs", "to": "mcp-server.cjs" }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vokabeltrainer",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zod": "^3.25.76"
  }
}
